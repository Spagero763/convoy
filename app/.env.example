# Copy to .env.local and fill in. Never commit .env.local.

# Deployed ConvoyVenue address. The board reads nothing until this is set.
NEXT_PUBLIC_VENUE_ADDRESS=

# Optional. Prepended to the built-in fallback list, which already covers
# lava.build, blast and nethermind.
NEXT_PUBLIC_RPC_URL=

# --- scripts only, never exposed to the browser ---

# Account used to declare, deploy and schedule batches. This key can create
# batches and pause joins. It cannot touch deposited value.
DEPLOYER_ADDRESS=
DEPLOYER_PRIVATE_KEY=

# Owner recorded on the venue. Defaults to DEPLOYER_ADDRESS.
# Use a multisig here for anything beyond a test deployment.
VENUE_OWNER=

RPC_URL=https://rpc.starknet.lava.build
